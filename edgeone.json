{
  "name": "flare-status",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "schedules": [
    {
      "name": "flarestatus-cron-probe",
      "cron": "*/2 * * * *",
      "path": "/api/cron-probe",
      "method": "POST",
      "timezone": "Asia/Shanghai"
    }
  ]
}
