{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-status",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "status.amatsuka.net",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // All state lives in the MonitorHub Durable Object's embedded SQLite database.
  // Workers KV was removed: a 2-minute cron against KV cannot fit the free-tier
  // ceiling of 1,000 writes/day, while SQLite-backed Durable Objects allow
  // 100,000 rows written/day.
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR_HUB",
        "class_name": "MonitorHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MonitorHub"]
    }
  ]
}
