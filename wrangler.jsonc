{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apple-status-page",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "status.amatsuka.net",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATUS_KV",
      "id": "349b39b70d4e47f88f0834a6c761167f"
    }
  ]
}
